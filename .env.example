# Copy to .env and fill in. Never commit .env.

# --- Data mode ---------------------------------------------------------------
# sample      offline fictional fixtures (no credentials needed)
# sec_direct  live SEC EDGAR XBRL API (needs SEC_USER_AGENT)
# zetaris     SEC EDGAR federated through your Zetaris instance (needs ZETARIS_* + scripts/zetaris_setup.py)
FINSIGHT_DATA_MODE=zetaris
# SAMPLE_MODE=true overrides the line above: fictional sample data, nothing connected.
SAMPLE_MODE=false
# In zetaris mode, also fetch the same facts from SEC directly and compare row counts / values.
FINSIGHT_ZETARIS_CROSS_CHECK=true

# SEC requires a declared User-Agent: "app_name contact@email".
SEC_USER_AGENT=

# --- Zetaris (github.com/zetaris/getting-started, scripts/HOWTO.md) ------------
# UI origin (not the raw :8888 API), numeric org id, and an API key OR username+password.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_LIGHTNING_DB=FINSIGHT_SEC
# Register a company's SEC sources in Zetaris automatically the first time it is looked up.
ZETARIS_AUTO_REGISTER=true
ZETARIS_SCHEMASTORE_CONTAINER=finsight

# --- Meterless ----------------------------------------------------------------
# H-MEM memory sidecar (services/hmem-sidecar)
HMEM_ENABLED=true
HMEM_URL=http://127.0.0.1:8765
# Meterless Runtime (Nightshift hotspot), OpenAI-compatible. Token lives in <stateDir>/proxy-token.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_TOKEN_FILE=
# NVIDIA Nemotron through Nightshift (add NVIDIA as a provider in the Nightshift app). Routing modes such as
# meterless/auto also work, but on a small Mac they pick local models with a 4,096-token context.
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- AI provider: auto | meterless | none -------------------------------------
# auto = Meterless Nightshift runtime if online, else no model.
# With no model, Parallax still answers: it writes every answer in code from the verified filings.
LLM_PROVIDER=auto

# --- Agent traces ---------------------------------------------------------------
# One JSON line per agent decision, in logs/runs/<trace_id>.jsonl and on stdout. Default folder: logs/.
# Set it to another folder, or to an empty value for stdout only.
# PARALLAX_LOG_DIR=logs

# Re-check the watchlist automatically every N minutes (0 = only when you click "Check").
WATCHLIST_CHECK_MINUTES=0

# --- Backend -------------------------------------------------------------------
# Default: SQLite at backend/finsight.db. Postgres example:
# DATABASE_URL=postgresql://finsight:finsight@localhost:5432/finsight
DATABASE_URL=
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
